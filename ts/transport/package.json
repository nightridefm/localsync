{
	"name": "@nightride/localsync",
	"version": "0.1.1",
	"description": "localdb SyncTransport for the localsync engine",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nightridefm/localsync.git",
		"directory": "ts/transport"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"check": "tsc -p tsconfig.json",
		"test": "node --test src/*.test.ts",
		"build": "node scripts/build-dist.mjs"
	}
}
