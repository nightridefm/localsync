{
	"name": "@nightride/localsync-harness",
	"private": true,
	"type": "module",
	"exports": {
		"./*": "./src/*"
	},
	"scripts": {
		"check": "tsc -p tsconfig.json",
		"matrix": "node src/run.ts",
		"bench": "node src/bench.ts",
		"bench:dense": "node src/bench-dense.ts",
		"bench:fanout": "node src/bench-fanout.ts",
		"bench:deflate": "node src/bench-deflate.ts",
		"bench:movein": "node src/bench-movein.ts",
		"hostile": "node src/hostile.ts",
		"gateway": "node --env-file-if-exists=../../.env src/gateway.ts"
	},
	"dependencies": {
		"@nightride/localsync": "workspace:*",
		"@sqlite.org/sqlite-wasm": "3.53.0-build1",
		"pg": "8.23.1"
	},
	"devDependencies": {
		"@types/pg": "8.23.1"
	}
}
