{
	"name": "localsync",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "go test -race ./... && pnpm -r --if-present test",
		"check": "go vet ./... && pnpm -r check",
		"lint": "oxlint --type-aware",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"harness": "pnpm --filter @nightride/localsync-harness",
		"sim": "pnpm --filter @nightride/localsync-sim",
		"browser": "pnpm --filter @nightride/localsync-browser"
	},
	"devDependencies": {
		"@types/node": "26.2.0",
		"oxfmt": "0.62.0",
		"oxlint": "1.77.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=26.13.0"
	},
	"packageManager": "pnpm@10.27.0"
}
